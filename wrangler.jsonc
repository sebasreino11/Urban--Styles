{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Un solo Worker sirve SSR, Server Actions, API Routes y los assets estáticos
  // (Workers Static Assets). worker.ts envuelve lo que genera `npm run build:cf`.
  "main": "worker.ts",
  "name": "urban-styles",
  // Cuenta Cloudflare del dueño de la barbería. Fijarla evita que `wrangler
  // deploy` publique en otra cuenta a la que el desarrollador tenga acceso.
  "account_id": "799cc572a4545968708434d6904143a7",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Solo el dominio propio: sin URL de workers.dev en paralelo.
  "workers_dev": false,
  "routes": [
    { "pattern": "dbarbershopurbanstyles.com", "custom_domain": true },
    { "pattern": "www.dbarbershopurbanstyles.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Auto-referencia que OpenNext usa para revalidaciones internas.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "urban-styles"
    }
  ],
  // Keep-alive: evita que Supabase Free pause el proyecto por inactividad.
  // El handler `scheduled` está en worker.ts y consulta la API REST de Supabase.
  "triggers": {
    "crons": ["0 */12 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Variables públicas (no secretas). Los secretos se cargan con
  // `npx wrangler secret put NOMBRE` — ver README › Despliegue. Las NEXT_PUBLIC_*
  // también van en .env.production.local: `next build` las incrusta en el JS.
  "vars": {
    "DEFAULT_SHOP_SLUG": "urban-styles",
    "NEXT_PUBLIC_SUPABASE_URL": "https://tctaixiltsnofgnukpcj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_UHNRTEAqDMBLKja6NBVNBw_czSf3QD2",
    "NEXT_PUBLIC_SITE_URL": "https://dbarbershopurbanstyles.com",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFeqlxNo7XCO3ysE",
    "EMAIL_FROM": "Urban Styles <reservas@dbarbershopurbanstyles.com>"
  }
}
