# =============================================================================
# Urban Styles — variables de entorno
# Copia este archivo a .env.local (desarrollo). En producción se configuran en
# Cloudflare (ver README › Despliegue). Detalle de cada una: README › Variables.
# =============================================================================

# --- Supabase (Project Settings › API Keys) ----------------------------------
# Pública: URL del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pública: publishable key (sb_publishable_…). Sujeta a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETA: secret key (sb_secret_…). Ignora RLS. Solo servidor, nunca en el navegador.
SUPABASE_SECRET_KEY=

# --- Sitio --------------------------------------------------------------------
# URL pública (para enlaces en correos). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Barbería que se muestra cuando el dominio no coincide con ninguna custom_domain.
DEFAULT_SHOP_SLUG=urban-styles

# --- Resend (correo al cliente) — resend.com › API Keys ------------------------
# SECRETA. Si falta, las reservas funcionan pero no se envía correo (queda en notification_log).
RESEND_API_KEY=
# Remitente. Con dominio sin verificar solo funciona onboarding@resend.dev (y solo hacia tu propio correo).
EMAIL_FROM="Urban Styles <onboarding@resend.dev>"

# --- Cloudflare Turnstile (anti-bots) — dash.cloudflare.com › Turnstile ---------
# Pública. Si ambas faltan, la verificación se omite (útil en desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRETA.
TURNSTILE_SECRET_KEY=

# --- Integraciones (opcional) ---------------------------------------------------
# SECRETA. Habilita POST /api/v1/bookings (p. ej. futuro bot de WhatsApp). Vacía = deshabilitado.
INTEGRATION_API_KEY=
